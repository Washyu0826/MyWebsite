{
  "name": "hsien-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:assets:browser": "node tests/assets-browser.mjs",
    "test:assets:sql": "node scripts/test-assets-sql.mjs",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "test:e2e": "playwright test tests/browser/site.spec.ts",
    "test:visual": "playwright test tests/browser/visual.spec.ts",
    "test:visual:update": "playwright test tests/browser/visual.spec.ts --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:site": "node scripts/audit-site.mjs",
    "audit:lighthouse": "node scripts/lighthouse-ci.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:push": "npx supabase db push",
    "db:seed:real": "npx supabase db query --linked -f supabase/seed-real.sql",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "next": "^15.5.24",
    "next-intl": "^4.3.9",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
